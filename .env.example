# PostgreSQL server
POSTGRES_DB=ecommerce
POSTGRES_ADMIN_USER=platform_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin
POSTGRES_PORT=5433

# Python ingestion
INGESTION_DB_USER=ingestion_user
INGESTION_DB_PASSWORD=change_me_ingestion
INGESTION_DB_HOST=127.0.0.1
INGESTION_DB_PORT=5433
INGESTION_DB_NAME=ecommerce
INGESTION_DB_CONNECT_TIMEOUT_SECONDS=10

# dbt transformations
# Local runtime uses the stable production schemas consumed by Metabase.
# Set DBT_TARGET=dev and DBT_SCHEMA=dbt_dev when developing in isolated schemas.
DBT_DB_USER=dbt_user
DBT_DB_PASSWORD=change_me_dbt
DBT_TARGET=prod
DBT_HOST=127.0.0.1
DBT_PORT=5433
DBT_DBNAME=ecommerce
DBT_SCHEMA=analytics
DBT_SSLMODE=disable

# Metabase read-only access
BI_DB_USER=bi_reader
BI_DB_PASSWORD=change_me_bi

# Apache Airflow
AIRFLOW_VERSION=3.3.0
AIRFLOW_UID=50000
AIRFLOW_API_PORT=8080

AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_admin

AIRFLOW_METADATA_DB_NAME=airflow
AIRFLOW_METADATA_DB_USER=airflow
AIRFLOW_METADATA_DB_PASSWORD=change_me_airflow_metadata

AIRFLOW_FERNET_KEY=replace_with_generated_fernet_key
AIRFLOW_JWT_SECRET=replace_with_long_random_jwt_secret

AIRFLOW_ORDERS_PER_RUN=30
AIRFLOW_ORDER_SEED=42

# Metabase configuration
METABASE_PORT=3000

METABASE_APP_DB_NAME=metabase
METABASE_APP_DB_USER=metabase_app
METABASE_APP_DB_PASSWORD=change-me_metabase_app

# Alerting and monitoring
# Leave ALERT_WEBHOOK_URL empty to persist alerts in PostgreSQL only.
ALERT_WEBHOOK_KIND=slack
ALERT_WEBHOOK_URL=

MONITOR_STALE_AFTER_HOURS=26
MONITOR_RUNNING_TIMEOUT_MINUTES=120
MONITOR_EXPECTED_RUN_HOUR_UTC=2
MONITOR_EXPECTED_RUN_GRACE_MINUTES=60

# Platzi Fake Store API
PLATZI_API_BASE_URL=https://api.escuelajs.co/api/v1
PLATZI_API_PAGE_SIZE=50
PLATZI_API_MAX_PAGES=100

# HTTP timeout configuration
PLATZI_API_CONNECT_TIMEOUT_SECONDS=5
PLATZI_API_READ_TIMEOUT_SECONDS=30
PLATZI_API_WRITE_TIMEOUT_SECONDS=10
PLATZI_API_POOL_TIMEOUT_SECONDS=5

# Retry configuration: total attempts, including the first request
PLATZI_API_MAX_ATTEMPTS=4
PLATZI_API_BACKOFF_SECONDS=1